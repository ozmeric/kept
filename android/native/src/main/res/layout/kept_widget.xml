<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/kept_widget_bg">
    <TextView
        android:id="@+id/w_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today's take-home"
        android:textColor="#CBD5E1"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/w_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#34D399"
        android:textSize="30sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/w_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tracking paused"
        android:textColor="#F1F5F9"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />
    <Button
        android:id="@+id/w_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Open Kept"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#04241A"
        android:background="@drawable/kept_widget_btn" />
</LinearLayout>
